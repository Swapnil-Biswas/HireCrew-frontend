# Copy to .env.local. All optional — the page renders without them.
# Put recordings in public/videos and reference them by path.
NEXT_PUBLIC_HERO_VIDEO=/videos/hero.mp4
NEXT_PUBLIC_IMPLEMENTATION_VIDEO=/videos/implementation.mp4
# Endpoint that accepts the JSON POST from the /join flow (HTTPS).
NEXT_PUBLIC_JOIN_ENDPOINT=
# Link to the Terms & Conditions document shown in the join flow.
NEXT_PUBLIC_TERMS_URL=
